# ==============================================================================
# Root .gitignore for Micro-Frontend Monorepo (Webpack Module Federation / React / TS)
# Rules defined here apply recursively to all micro-frontends (host, auth-mfe, etc.)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production / Webpack build outputs
dist/
build/
out/
*.tsbuildinfo

# Build tool caches
.cache/
.webpack/

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# IDE & Editor folders
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
